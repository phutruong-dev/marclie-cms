# Chuẩn hoá line-ending: mọi file text dùng LF trong repo (tránh cảnh báo CRLF trên Windows)
* text=auto eol=lf

# Script bắt buộc LF
*.sh   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Nhị phân — không đụng eol
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.mp4  binary
*.pdf  binary
